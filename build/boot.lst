   387 000002A8 4344303031              iso_sig:     db 'CD001'
   388 000002AD 4B45524E454C2E4249-     kernel_name: db 'KERNEL.BIN'
   388 000002B6 4E                 
   389 000002B7 46423D00                dbg_fb_msg:  db 'FB=', 0
   390 000002BB 0D0A00                  dbg_crlf:    db 13, 10, 0
