   426                                  ; -------------------------
   427                                  ; Disk Address Packet (int 13h AH=42h). LBA and count are in
   428                                  ; 512-byte logical blocks (USB). read_cd sets count=4 before each use.
   429                                  ; -------------------------
   430                                  
   431                                  dap:
   432 000002DC 10                          db 16            ; packet size
   433 000002DD 00                          db 0
   434                                  dap_cnt:
   435 000002DE 0400                        dw 4             ; count = 4 × 512 = 2048 bytes
   436                                  dap_off:
   437 000002E0 0000                        dw 0
   438                                  dap_seg:
   439 000002E2 0000                        dw 0
   440                                  dap_lba:
   441 000002E4 0000000000000000            dq 0
   442                                  
   443                                  ; -------------------------
   444                                  ; Protected Mode
   445                                  ; -------------------------
   446                                  
   447                                  bits 32
   448                                  
   449                                  protected_mode:
   450 000002EC 66B81000                    mov ax, DATA_SEG
   451 000002F0 8ED8                        mov ds, ax
   452 000002F2 8EC0                        mov es, ax
   453 000002F4 8ED0                        mov ss, ax
   454                                  
   455                                      ; calls startup.asm
   456                                  
   457 000002F6 EA008000000800              jmp CODE_SEG:0x8000
   458                                  
   459                                  hang:
   460 000002FD FA                          cli
   461 000002FE F4                          hlt
   462 000002FF EBFC                        jmp hang
   463                                  
   464                                  ; El Torito no-emulation: no 0xAA55 signature is checked and the boot
   465                                  ; image may exceed 512 bytes. Pad to a full 2048-byte sector.
   466 00000301 00<rep 4FFh>            times 2048-($-$$) db 0
