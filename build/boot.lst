   393                                  ; GDT
   394                                  ; -------------------------
   395                                  
   396                                  gdt_start:
   397                                  
   398                                  gdt_null:
   399 000002BE 0000000000000000            dq 0
   400                                  
   401                                  gdt_code:
   402 000002C6 FFFF                        dw 0xffff
   403 000002C8 0000                        dw 0x0000
   404 000002CA 00                          db 0x00
   405 000002CB 9A                          db 10011010b
   406 000002CC CF                          db 11001111b
   407 000002CD 00                          db 0x00
   408                                  
   409                                  gdt_data:
   410 000002CE FFFF                        dw 0xffff
   411 000002D0 0000                        dw 0x0000
   412 000002D2 00                          db 0x00
   413 000002D3 92                          db 10010010b
   414 000002D4 CF                          db 11001111b
   415 000002D5 00                          db 0x00
   416                                  
   417                                  gdt_end:
   418                                  
   419                                  gdt_descriptor:
   420 000002D6 1700                        dw gdt_end - gdt_start - 1
   421 000002D8 [BE020000]                  dd gdt_start
   422                                  
   423                                  CODE_SEG equ gdt_code - gdt_start
   424                                  DATA_SEG equ gdt_data - gdt_start
