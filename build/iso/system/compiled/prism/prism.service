/* Cubic System Software - Prism Service */
/* High-level desktop: dock, icons, window management */

#include "quartz.h"
#include "service.h"
#include "framebuffer.h"
#include "prism.h"
#include "fs.h"

// Code by NixPanqueca -w-

int running;

static void DrawDock(void) {
    // Dock background
    FB_drawrect(0,screen_height-24, 250, screen_height, 0x00000000);
    FB_drawrect(0,screen_height-23, 249, screen_height, 0x00C0C0C0); // dock
    FB_drawrect(0,screen_height-22, 247, screen_height-22, 0x00FFFFFF);

    // Dock tiles
    const fs_file_t* tile1 = fs_find("/system/compiled/prism/bitmap/dock/tileT1.bmp");
    const fs_file_t* ratio = fs_find("/system/compiled/prism/bitmap/dock/ratioOUTTER.bmp");
    const fs_file_t* ratio2 = fs_find("/system/compiled/prism/bitmap/dock/ratioINNER.bmp");
    if (ratio && ratio2) {
        FB_drawbmp(0,screen_height-24, (const void*)(uint32_t)ratio->mod_start);
        FB_drawbmp(5,screen_height-14, (const void*)(uint32_t)ratio2->mod_start);
    } else {
        kernel_crash(0x00194);
    }
}

void RoundedCorners() {
    FB_drawrect(5,1, 7,1, 0x00FFFFFF);
    FB_drawrect(4,2, 4,2, 0x00FFFFFF);
    FB_drawrect(3,3, 3,3, 0x00FFFFFF);
    FB_drawrect(2,4, 2,4, 0x00FFFFFF);
    FB_drawrect(1,5, 1,7, 0x00FFFFFF);
    FB_drawrect(0,8, 0,17, 0x00FFFFFF);
    FB_drawrect(0,18, 0,18, 0x00DDDDDD);
    FB_drawrect(7,0, 7,0, 0x00DDDDDD);

    /* left corner */
    FB_drawrect(0,0, 6,0, 0x00AAAAAA);
    FB_drawrect(0,1, 4,1, 0x00AAAAAA);
    FB_drawrect(0,4, 1,4, 0x00AAAAAA);
    FB_drawrect(0,6, 0,6, 0x00AAAAAA);

    FB_drawrect(0,0, 5,0, 0x00555555);
    FB_drawrect(0,1, 3,1, 0x00555555);
    FB_drawrect(0,2, 2,2, 0x00555555);
    FB_drawrect(0,3, 1,3, 0x00555555);
    FB_drawrect(0,5, 0,5, 0x00555555);

    FB_drawrect(0,0, 4,0, 0x00000000);
    FB_drawrect(0,1, 2,1, 0x00000000);
    FB_drawrect(0,2, 1,2, 0x00000000);
    FB_drawrect(0,3, 0,3, 0x00000000);
    FB_drawrect(0,4, 0,4, 0x00000000);

    /* right corner */
    FB_drawrect(screen_width-7,0, screen_width-1,0, 0x00AAAAAA);
    FB_drawrect(screen_width-5,1, screen_width-1,1, 0x00AAAAAA);
    FB_drawrect(screen_width-2,4, screen_width-1,4, 0x00AAAAAA);
    FB_drawrect(screen_width-1,6, screen_width-1,6, 0x00AAAAAA);

    FB_drawrect(screen_width-6,0, screen_width-1,0, 0x00555555);
    FB_drawrect(screen_width-4,1, screen_width-1,1, 0x00555555);
    FB_drawrect(screen_width-3,2, screen_width-1,2, 0x00555555);
    FB_drawrect(screen_width-2,3, screen_width-1,3, 0x00555555);
    FB_drawrect(screen_width-1,5, screen_width-1,5, 0x00555555);

    FB_drawrect(screen_width-5,0, screen_width-1,0, 0x00000000);
    FB_drawrect(screen_width-3,1, screen_width-1,1, 0x00000000);
    FB_drawrect(screen_width-2,2, screen_width-1,2, 0x00000000);
    FB_drawrect(screen_width-1,3, screen_width-1,3, 0x00000000);
    FB_drawrect(screen_width-1,4, screen_width-1,4, 0x00000000);
}

void PrismUpdate() {
    DrawDock();
}

static service_func_t prism_funcs[] = {
    { "Update", PrismUpdate },
    { 0, 0 }
};

void Init(void) {
    running = 1;
    PrismSetTitle("Prism");
    RoundedCorners();
    DrawDock();
    while (running == 1) {
        __asm__ __volatile__("hlt");
    }
}

void Shutdown(void) {
    /* cleanup */
    running = 0;
}

SERVICE_REGISTER("/system/compiled/prism/prism.service", "Prism", SERVICE_TYPE_SERVICE, prism_funcs)
